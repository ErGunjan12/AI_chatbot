# AI Customer Support Assistant - Environment Variables Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=ai_customer_support
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PERSIST_DIRECTORY=./chroma_db

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@businessassistant.ai

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
MAX_UPLOAD_SIZE_MB=15
